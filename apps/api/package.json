{
  "name": "@siscr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:shared": "wrangler d1 migrations apply siscr-shared-staging --local",
    "db:migrate:shared:remote": "wrangler d1 migrations apply siscr-shared-staging --remote",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@xmldom/xmldom": "^0.8.12",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.0",
    "node-forge": "^1.4.0",
    "stripe": "^17.0.0",
    "xml-core": "^1.2.5",
    "xmldsigjs": "^2.8.7",
    "xpath": "^0.0.34",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "@types/node-forge": "^1.3.14",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.4.0"
  }
}
